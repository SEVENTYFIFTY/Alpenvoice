# === Anthropic API ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Email / SMTP ===
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=you@gmail.com
FROM_NAME=Alpenvoice Sales

# === Zoom (Server-to-Server OAuth) ===
# Create at https://marketplace.zoom.us/develop/create -> Server-to-Server OAuth
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret
ZOOM_HOST_EMAIL=host@yourcompany.com

# === Business Info (used in emails) ===
BUSINESS_NAME=Alpenvoice
BUSINESS_DESCRIPTION=AI-powered voice solutions for hospitality and fitness businesses
SALES_REP_NAME=Alex Johnson
SALES_REP_TITLE=Account Executive
CALENDAR_URL=https://calendly.com/your-link

# === Agent Behavior ===
DRY_RUN=true        # Set to false to actually send emails and create Zoom meetings
FOLLOW_UP_DAYS=3    # Days between follow-ups
MAX_FOLLOW_UPS=2    # Max number of follow-up emails per prospect
DB_PATH=prospects.db
